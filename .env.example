# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=bid_scheduler
POSTGRES_PASSWORD=bid_scheduler_dev
POSTGRES_DB=bid_scheduler
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bid_scheduler:bid_scheduler_dev@localhost:5432/bid_scheduler

# NextAuth (Auth.js) — credentials login until Microsoft Entra ID SSO is wired up.
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-random-32-byte-base64-string
