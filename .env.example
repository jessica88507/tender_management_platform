# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=bid_scheduler
POSTGRES_PASSWORD=bid_scheduler_dev
POSTGRES_DB=bid_scheduler
POSTGRES_PORT=5432

DATABASE_URL=postgresql://bid_scheduler:bid_scheduler_dev@localhost:5432/bid_scheduler

# NextAuth (Auth.js) — credentials login until Microsoft Entra ID SSO is wired up.
# Generate your own: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=replace-with-a-random-32-byte-base64-string

# Self-hosted LLM (Ollama) powering the in-app 系統助理 Q&A chat — see
# src/app/api/assistant/chat/route.ts and docs/DECISIONS.md. Point this at a URL that reaches your
# Ollama's /api/chat endpoint (e.g. via a Cloudflare Tunnel if Ollama runs outside this deployment),
# and set LOCAL_LLM_SECRET to whatever bearer token your proxy in front of it expects. Without both
# set, the chat feature returns a clear "not configured" error instead of failing silently.
LOCAL_LLM_URL=
LOCAL_LLM_SECRET=
