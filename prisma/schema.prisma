// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth (NextAuth.js / Microsoft Entra ID) ----------
// Standard NextAuth Prisma-adapter shape, extended with `department` for
// gating login to the 業務部 (sales/bid) department and case-ownership checks.

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  department    String?

  accounts     Account[]
  sessions     Session[]
  leadCases    Case[]    @relation("BidLead")
  createdCases Case[]    @relation("CreatedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------- Domain ----------

enum TeamGroup {
  architect
  jianguo
}

enum SimpleTeamKind {
  architect
  mep
}

model Case {
  id   String @id @default(uuid())
  name String

  workStart   DateTime @map("work_start") @db.Date
  tenderStart DateTime @map("tender_start") @db.Date
  deadline    DateTime

  // 主投標手：free-text display name (kept for scheduling defaults / legacy data)
  // plus an optional link to the logged-in user who owns edit rights on this case.
  bidLeadName   String  @default("") @map("bid_lead_name")
  bidLeadUserId String? @map("bid_lead_user_id")

  meetingWeekday Int     @default(2) @map("meeting_weekday")
  contractAmount Decimal @default(0) @map("contract_amount") @db.Decimal(18, 0)
  siteArea       Float   @default(0) @map("site_area")
  floorArea      Float   @default(0) @map("floor_area")
  floorCount     String  @default("") @map("floor_count")

  createdByUserId String? @map("created_by_user_id")

  bidLead   User? @relation("BidLead", fields: [bidLeadUserId], references: [id], onDelete: SetNull)
  createdBy User? @relation("CreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  tasks       Task[]
  teamMembers TeamMember[]
  consultants Consultant[]
  weekNotes   WeekNote[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([bidLeadUserId])
  @@map("cases")
}

model Task {
  id     String @id @default(uuid())
  caseId String @map("case_id")

  cat       String
  label     String
  owner     String   @default("")
  due       DateTime @db.Date
  done      Boolean  @default(false)
  milestone String?

  // Optional per-task Outlook calendar sync (see project spec item 5)
  syncToOutlook  Boolean @default(false) @map("sync_to_outlook")
  outlookEventId String? @map("outlook_event_id")

  sortIndex Int @default(0) @map("sort_index")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([caseId])
  @@index([caseId, due])
  @@map("tasks")
}

// 建築師 / 機電團隊 simple name lists (per case)
model TeamMember {
  id     String @id @default(uuid())
  caseId String @map("case_id")

  kind      SimpleTeamKind
  name      String
  sortIndex Int            @default(0) @map("sort_index")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("team_members")
}

// 專業顧問，可拖曳分類到 建築師團隊 / 建國工程團隊
model Consultant {
  id     String @id @default(uuid())
  caseId String @map("case_id")

  role        String
  company     String     @default("")
  contact     String     @default("")
  affiliation String     @default("")
  isCustom    Boolean    @default(true) @map("is_custom")
  teamGroup   TeamGroup? @map("team_group")
  sortIndex   Int        @default(0) @map("sort_index")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("consultants")
}

// 行事曆檢視「本週目標/備注」欄位
model WeekNote {
  id     String @id @default(uuid())
  caseId String @map("case_id")

  weekStart DateTime @map("week_start") @db.Date
  note      String   @default("")

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, weekStart])
  @@map("week_notes")
}
